{
  "name": "eth-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "api:dev": "tsx watch src/backend/index.ts",
    "api:start": "node dist/backend/index.js",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier -w .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bignumber.js": "^10.0.2",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^5.2.1",
    "mongoose": "^8.9.5",
    "pino": "^9.5.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
